{
  "name": "flightplan",
  "version": "0.0.1",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "flightplan": "src/cli/index.ts"
  },
  "scripts": {
    "flightplan": "bun run src/cli/index.ts",
    "fixtures": "bun run examples/fixtures/server.ts",
    "dev:link-browser-pilot": "bun run scripts/browser-pilot-dependency.ts link",
    "verify:browser-pilot": "bun run scripts/browser-pilot-dependency.ts verify",
    "verify:browser-pilot:packed": "bun run scripts/browser-pilot-dependency.ts packed",
    "check": "bun run scripts/check.ts",
    "lint": "bun run scripts/check.ts lint",
    "lint:fix": "biome check --write . && oxlint --type-aware --fix",
    "format": "biome format --write .",
    "typecheck": "bun run scripts/check.ts typecheck",
    "test": "bun run scripts/check.ts test"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.86",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^6.0.0",
    "browser-pilot": "file:/Users/jan/Documents/GitHub/browser-pilot",
    "smol-toml": "^1.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "latest",
    "chrome-launcher": "1.2.1",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^5"
  }
}

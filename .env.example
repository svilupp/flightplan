# Flightplan environment variables. Copy to `.env` and fill in.
# Deterministic L0/L1 runs and warm lock replays can be keyless when they stay at L0 and invoke
# no AI-backed step or assertion.
# Cold runs that escalate to L2-L5, or AI-backed steps/assertions such as an ai_pick escalation
# or ai_judge, need OPENROUTER_API_KEY.

# One OpenRouter key serves both text and vision models (vision runs through
# OpenRouter too — there is no separate provider key). Default env-var name; override with
# [ai].api_key_env in config.
OPENROUTER_API_KEY=

# Optional. Enables Logfire telemetry spans when set (gating is "auto" by default: on iff a
# token is present). Default env-var name; override with [telemetry.logfire].token_env.
LOGFIRE_TOKEN=

# Cloudflare hosted browser — authenticates browser allocation.
# Required only for native [config.connect] mode = "hosted" with Cloudflare.
# A hosted browser visiting a public website needs only this pair.
# Use a scoped API token, not a Global API key. Default env-var names; override
# with [config.connect].account_id_env and api_token_env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Access — authenticates access to the target website.
# Required only when using service-token auth for an Access-protected website;
# configure [config.auth.cf_access] with these env-var names.
# A local browser needs only this pair; a hosted Cloudflare browser needs both
# pairs (all four values). Public websites do not need this pair.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
